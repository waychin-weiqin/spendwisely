DATABASE_URL=postgres://user:pass@host:5432/dbname
SESSION_SECRET=replace_me

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini

# Monthly summary job
ENABLE_SUMMARY_JOB=true
APP_BASE_URL=http://localhost:5000

# Admin test endpoints (disable in production)
ENABLE_ADMIN_ENDPOINTS=false
ADMIN_TOKEN=replace_me

# Admin UI (local testing only)
VITE_ENABLE_ADMIN_UI=false
VITE_ADMIN_TOKEN=replace_me

# SMTP (optional for now)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_user
SMTP_PASS=your_pass
SMTP_FROM=SpendWise <no-reply@example.com>
